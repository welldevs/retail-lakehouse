# Copy to .env and adjust. .env is in .gitignore: credentials never enter the repo.
#
# These are LOCAL DEVELOPMENT credentials. Do not reuse them in anything exposed.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Consumed by the platform (platform/src/retail_platform/config.py) and by DuckDB.
S3_ENDPOINT=http://localhost:9000
# DuckDB wants host:port WITHOUT a scheme; boto3 wants the full URL. Both are needed.
S3_ENDPOINT_HOST=localhost:9000
RAW_BUCKET=retail-raw
LAKEHOUSE_BUCKET=retail-lakehouse

# DuckDB state file (the real data lives in object storage).
DUCKDB_PATH=platform/dbt/retail.duckdb

# Host UID, so that files Airflow writes under data/ are not owned by
# 50000 in the checkout. Get it with: id -u
AIRFLOW_UID=1000
AIRFLOW_PORT=8080

# Orders OLTP (compose `stream` profile — NOT started by `make up`). The event is born
# inside the transaction that changes the order; see ARCHITECTURE.md (stream plane).
# Development credential, like the ones above.
OLTP_PORT=5433
OLTP_DSN=postgresql://oltp:oltp@localhost:5433/oltp

# Event broker (same `stream` profile). The topic is created by `kafka-init` with 4
# partitions: with a single one, ordering would be global by accident and the "order per
# key" guarantee would never be exercised.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP=localhost:9092
PROJECTION_DSN=postgresql://oltp:oltp@localhost:5433/projection

# DEFAULT warehouse since CR-007 (compose `warehouse-postgres` profile — NOT started by
# `make up`; use `make warehouse-postgres-up`). Snowflake is optional — see DECISIONS.md.
# Development credential, like the ones above; there is no real secret here, which is why
# (unlike Snowflake) there is no separate .env.warehouse-postgres.
WAREHOUSE_PG_PORT=5434
WAREHOUSE_PG_HOST=localhost
WAREHOUSE_PG_USER=retail
WAREHOUSE_PG_PASSWORD=retail
WAREHOUSE_PG_DB=retail

# Interface the ports listen on. 127.0.0.1 is the default and must stay that way
# while the credentials above are development ones.
BIND_ADDR=127.0.0.1

# Generated by `make secrets` — they must NOT have a fixed value in a versioned file, and
# compose refuses to start without them.
AIRFLOW_SECRET_KEY=
AIRFLOW_FERNET_KEY=

# ---------------------------------------------------------------------------
# Optional overrides. ALL of them have a default in the code and nothing needs to be
# set here — the list exists because a variable the code reads and the
# documentation does not mention is invisible configuration. The values below ARE the
# defaults; uncomment only what you need to change.
# ---------------------------------------------------------------------------

# Platform (retail_platform)
# AWS_ACCESS_KEY_ID=                        # if set, they WIN over MINIO_ROOT_*:
# AWS_SECRET_ACCESS_KEY=                    # this is the way to point at a real S3
# AWS_DEFAULT_REGION=us-east-1              # S3 client region; MinIO ignores it, S3 does not
# KAFKA_ORDERS_TOPIC=retail.orders.events.v1
# KAFKA_ORDERS_GROUP=orders-projector       # the Iceberg sink uses its own group, by design
# ICEBERG_CATALOG_NAME=retail
# ICEBERG_CATALOG_DB=iceberg_catalog        # the SQL catalog lives in oltp-postgres itself
# ICEBERG_NAMESPACE=projection
# ICEBERG_WAREHOUSE=s3://retail-lakehouse/iceberg

# ---- stock (Phase 7) — the Spark job and the catalog it shares ---------------
# STOCK_NAMESPACE=operations                # namespace of the stock tables in the SAME
#                                           # Iceberg catalog as the live projection
# STOCK_PREMISES_CSV=/repo/platform/dbt/seeds/stock_premises_seed.csv
#                                           # path INSIDE the Spark container; the
#                                           # repository is mounted at /repo, read-only

# Streamlit panel (operations)
# RETAIL_DASHBOARD_ROLE=retail_reader       # changing it here is how to PROVE the refusal on GOLD
# RETAIL_DASHBOARD_TTL=60                   # cache seconds per query
# RETAIL_DASHBOARD_SMOKE_TIMEOUT=600        # timeout of `make dashboard-check` (renders both panels)

# Streamlit panel (prices) — dedicated, same retail_reader session as the panel above
# RETAIL_PRICE_DASHBOARD_TTL=60             # cache seconds per query

# Airflow DAGs (read inside the container; compose already sets the rest)
# RETAIL_CALLEJERO_IN=<repo>/temp
# RETAIL_CALLEJERO_PROVINCES=08,28,41,46
# RETAIL_OLTP_WAREHOUSES=mad1,bcn1,svq1,vlc1
# RETAIL_ORDERS_WAREHOUSES=mad1,bcn1,svq1,vlc1
# RETAIL_SNOWFLAKE_DATABASE=RETAIL
# RETAIL_SNOWFLAKE_CONNECTION=spark_retail  # block in ~/.snowflake/config.toml
# RETAIL_SNOWFLAKE_LOAD_ROLE=RETAIL_LOADER

# Second warehouse target (local Postgres, fallback for the Snowflake trial)
# RETAIL_WAREHOUSE_PG_LOAD_ROLE=retail_loader  # role activated by `set role` during the load
