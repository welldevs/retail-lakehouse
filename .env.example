# Copie para .env e ajuste. .env esta no .gitignore: credencial nao entra no repo.
#
# Estas sao credenciais de DESENVOLVIMENTO LOCAL. Nao reutilize em nada exposto.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Consumido pela plataforma (platform/src/retail_platform/config.py) e pelo DuckDB.
S3_ENDPOINT=http://localhost:9000
# O DuckDB quer host:porta SEM esquema; o boto3 quer a URL completa. Sao os dois.
S3_ENDPOINT_HOST=localhost:9000
RAW_BUCKET=retail-raw
LAKEHOUSE_BUCKET=retail-lakehouse

# Arquivo de estado do DuckDB (o dado real vive no object storage).
DUCKDB_PATH=platform/dbt/retail.duckdb

# UID do host, para que os arquivos escritos pelo Airflow em data/ nao fiquem com dono
# 50000 no checkout. Gere com: id -u
AIRFLOW_UID=1000
AIRFLOW_PORT=8080

# OLTP de pedidos (profile `stream` do compose — NAO sobe com `make up`). O evento nasce
# dentro da transacao que muda o pedido; ver README "OLTP e outbox". Credencial de
# desenvolvimento, como as de cima.
OLTP_PORT=5433
OLTP_DSN=postgresql://oltp:oltp@localhost:5433/oltp

# Broker de eventos (mesmo profile `stream`). O topico e criado por `kafka-init` com 4
# particoes: com uma so, a ordem seria global por acaso e a garantia "ordem por chave"
# nunca seria exercida.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP=localhost:9092
PROJECTION_DSN=postgresql://oltp:oltp@localhost:5433/projection

# Interface em que as portas escutam. 127.0.0.1 e o padrao e deve continuar assim
# enquanto as credenciais acima forem de desenvolvimento.
BIND_ADDR=127.0.0.1

# Gerados por `make secrets` — NAO devem ter valor fixo em arquivo versionado, e o
# compose recusa subir sem eles.
AIRFLOW_SECRET_KEY=
AIRFLOW_FERNET_KEY=

# ---------------------------------------------------------------------------
# Sobrescritas opcionais. TODAS tem default no codigo e nada precisa ser
# definido aqui — a lista existe porque uma variavel que o codigo le e que a
# documentacao nao cita e uma configuracao invisivel. Os valores abaixo SAO os
# defaults; descomente so o que precisar mudar.
# ---------------------------------------------------------------------------

# Plataforma (retail_platform)
# AWS_ACCESS_KEY_ID=                        # se definidas, GANHAM de MINIO_ROOT_*:
# AWS_SECRET_ACCESS_KEY=                    # e o caminho para apontar num S3 de verdade
# AWS_DEFAULT_REGION=us-east-1              # region do cliente S3; o MinIO ignora, o S3 nao
# KAFKA_ORDERS_TOPIC=retail.orders.events.v1
# KAFKA_ORDERS_GROUP=orders-projector       # o sink Iceberg usa grupo proprio, por desenho
# ICEBERG_CATALOG_NAME=retail
# ICEBERG_CATALOG_DB=iceberg_catalog        # o catalogo SQL mora no proprio oltp-postgres
# ICEBERG_NAMESPACE=projection
# ICEBERG_WAREHOUSE=s3://retail-lakehouse/iceberg

# Painel Streamlit
# RETAIL_DASHBOARD_ROLE=RETAIL_READER       # trocar aqui e o jeito de PROVAR a recusa em GOLD
# RETAIL_DASHBOARD_TTL=60                   # segundos de cache por consulta
# RETAIL_DASHBOARD_SMOKE_TIMEOUT=600        # limite do `make dashboard-check`

# DAGs do Airflow (lidas no container; o compose ja define as demais)
# RETAIL_CALLEJERO_IN=<repo>/temp
# RETAIL_CALLEJERO_PROVINCES=08,28,41,46
# RETAIL_OLTP_WAREHOUSES=mad1,bcn1,svq1,vlc1
# RETAIL_ORDERS_WAREHOUSES=mad1,bcn1,svq1,vlc1
# RETAIL_SNOWFLAKE_DATABASE=RETAIL
# RETAIL_SNOWFLAKE_CONNECTION=spark_retail  # bloco de ~/.snowflake/config.toml
# RETAIL_SNOWFLAKE_LOAD_ROLE=RETAIL_LOADER
