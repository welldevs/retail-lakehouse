# Copie para .env e ajuste. .env esta no .gitignore: credencial nao entra no repo.
#
# Estas sao credenciais de DESENVOLVIMENTO LOCAL. Nao reutilize em nada exposto.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Consumido pela plataforma (platform/src/retail_platform/config.py) e pelo DuckDB.
S3_ENDPOINT=http://localhost:9000
# O DuckDB quer host:porta SEM esquema; o boto3 quer a URL completa. Sao os dois.
S3_ENDPOINT_HOST=localhost:9000
RAW_BUCKET=retail-raw
LAKEHOUSE_BUCKET=retail-lakehouse

# Arquivo de estado do DuckDB (o dado real vive no object storage).
DUCKDB_PATH=platform/dbt/retail.duckdb

# UID do host, para que os arquivos escritos pelo Airflow em data/ nao fiquem com dono
# 50000 no checkout. Gere com: id -u
AIRFLOW_UID=1000
AIRFLOW_PORT=8080

# OLTP de pedidos (profile `stream` do compose — NAO sobe com `make up`). O evento nasce
# dentro da transacao que muda o pedido; ver README "OLTP e outbox". Credencial de
# desenvolvimento, como as de cima.
OLTP_PORT=5433
OLTP_DSN=postgresql://oltp:oltp@localhost:5433/oltp

# Broker de eventos (mesmo profile `stream`). O topico e criado por `kafka-init` com 4
# particoes: com uma so, a ordem seria global por acaso e a garantia "ordem por chave"
# nunca seria exercida.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP=localhost:9092
PROJECTION_DSN=postgresql://oltp:oltp@localhost:5433/projection

# Interface em que as portas escutam. 127.0.0.1 e o padrao e deve continuar assim
# enquanto as credenciais acima forem de desenvolvimento.
BIND_ADDR=127.0.0.1

# Gerados por `make secrets` — NAO devem ter valor fixo em arquivo versionado, e o
# compose recusa subir sem eles.
AIRFLOW_SECRET_KEY=
AIRFLOW_FERNET_KEY=
