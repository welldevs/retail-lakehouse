# Snowflake account identity. Copy to .env.snowflake (gitignored) and fill in.
#
# THIS FILE HOLDS NO SECRET. Account, user, role, database and warehouse are
# identifiers; the only secret in the flow is the RSA private key, which lives outside the
# repository with mode 600 and of which only the PATH travels here.
#
# SWITCHING SNOWFLAKE ACCOUNTS = edit this file and the matching block of
# ~/.snowflake/config.toml, and run `make warehouse-snowflake-bootstrap` once. No model,
# no SQL and no test changes: the boundary between the Lakehouse and the warehouse is physical
# (parquet + COPY INTO), so the target is swappable by construction. The Lakehouse half
# depends on none of this and keeps running offline.

# --- read by platform/dbt/profiles.yml (snowflake target) ---------------------
# No default in profiles.yml: when missing, dbt aborts naming the variable, instead
# of trying to connect to someone else's account.
SNOWFLAKE_ACCOUNT=ORGID-ACCOUNT
SNOWFLAKE_USER=SEU_USUARIO

# TRANSFORMATION role. RETAIL_TRANSFORMER reads STAGE and writes GOLD and MART — it is not
# ACCOUNTADMIN on purpose. Created by `make warehouse-snowflake-bootstrap`.
SNOWFLAKE_ROLE=RETAIL_TRANSFORMER

SNOWFLAKE_DATABASE=RETAIL
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PRIVATE_KEY_PATH=/home/SEU_USUARIO/.snowflake/keys/spark_retail_rsa.p8

# --- read by platform/src/retail_platform/snowflake_load.py ------------------
# Name of the [connections.X] block in ~/.snowflake/config.toml, from which the Python
# connector reads the credential. The administrative role stays on THAT connection because it
# is the one that runs the bootstrap; the load overrides it to RETAIL_LOADER.
RETAIL_SNOWFLAKE_CONNECTION=spark_retail
RETAIL_SNOWFLAKE_LOAD_ROLE=RETAIL_LOADER

# --- user that receives the three roles at bootstrap --------------------------
# Dedicated prefix on purpose: a variable named SNOWFLAKE_USER here would reach dbt empty
# because of the Makefile `export`, and `env_var` returns the empty value, not the default.
SNOWFLAKE_GRANT_USER=SEU_USUARIO
