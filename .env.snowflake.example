# Identidade da conta Snowflake. Copie para .env.snowflake (gitignored) e preencha.
#
# ESTE ARQUIVO NAO GUARDA SEGREDO. Conta, usuario, papel, database e warehouse sao
# identificadores; o unico segredo do fluxo e a chave privada RSA, que mora fora do
# repositorio com modo 600 e da qual aqui viaja apenas o CAMINHO.
#
# TROCAR DE CONTA SNOWFLAKE = editar este arquivo e o bloco correspondente de
# ~/.snowflake/config.toml, e rodar `make warehouse-bootstrap` uma vez. Nenhum modelo,
# nenhum SQL e nenhum teste muda: a fronteira entre o Lakehouse e o warehouse e fisica
# (parquet + COPY INTO), entao o destino e trocavel por construcao. A metade Lakehouse
# nao depende de nada disto e continua rodando offline.

# --- lido por platform/dbt/profiles.yml (target snowflake) --------------------
# Sem default no profiles.yml: ausentes, o dbt aborta dizendo o nome da variavel, em vez
# de tentar conectar na conta de outra pessoa.
SNOWFLAKE_ACCOUNT=ORGID-ACCOUNT
SNOWFLAKE_USER=SEU_USUARIO

# Papel da TRANSFORMACAO. RETAIL_TRANSFORMER le STAGE e escreve GOLD e MART — nao e
# ACCOUNTADMIN de proposito. Criado por `make warehouse-bootstrap`.
SNOWFLAKE_ROLE=RETAIL_TRANSFORMER

SNOWFLAKE_DATABASE=RETAIL
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PRIVATE_KEY_PATH=/home/SEU_USUARIO/.snowflake/keys/spark_retail_rsa.p8

# --- lido por platform/src/retail_platform/snowflake_load.py -----------------
# Nome do bloco [connections.X] em ~/.snowflake/config.toml, de onde o conector Python le
# a credencial. O papel administrativo fica NESSA conexao porque e ela que roda o
# bootstrap; a carga sobrescreve para RETAIL_LOADER.
RETAIL_SNOWFLAKE_CONNECTION=spark_retail
RETAIL_SNOWFLAKE_LOAD_ROLE=RETAIL_LOADER

# --- usuario que recebe os tres papeis no bootstrap --------------------------
# Prefixo proprio de propósito: uma variavel chamada SNOWFLAKE_USER aqui chegaria vazia ao
# dbt por causa do `export` do Makefile, e `env_var` devolve o vazio, nao o default.
SNOWFLAKE_GRANT_USER=SEU_USUARIO
