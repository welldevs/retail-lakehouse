__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Temporarios da escrita atomica: nunca devem sobreviver a uma execucao.
.tmp-*.json

# Configuracao local de maquina.
.claude/settings.local.json

# Os snapshots em data/ sao artefato de execucao, nao codigo-fonte. A verdade do RAW
# passou a ser o object storage (s3://retail-raw/...); data/ e scratch da extracao.
data/

# Callejero do INE baixado manualmente (sem API) para derivar warehouse_province_map —
# arquivo grande de referencia, nao codigo-fonte. A verdade passa a ser o seed CSV em
# platform/dbt/seeds/, versionado; ver scripts/derive_warehouse_province_map.py.
temp/

# Venvs: da plataforma e do Airflow. O da Source (venv/) ja esta acima.
platform/.venv/
orchestration/.venv/

# Artefatos do dbt. O dado real vive no object storage; o .duckdb e so estado local.
platform/dbt/target/
platform/dbt/logs/
platform/dbt/retail.duckdb
platform/dbt/package-lock.yml

# Credenciais locais do MinIO / plataforma.
.env

platform/dbt/.user.yml
