__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Atomic-write temporaries: they must never survive a run.
.tmp-*.json

# Claude Code local configuration and state (settings, scheduled tasks, checkpoints,
# worktrees, mailbox). Not part of the project; it is per machine/session of each contributor.
.claude/

# OS and editor clutter: never part of the project, only of the editor's environment.
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# Python test/lint caches: generated by running pytest/mypy/ruff/coverage locally, never
# an input to anything.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The snapshots in data/ are run artifacts, not source code. The RAW truth is now
# the object storage (s3://retail-raw/...); data/ is extraction scratch.
data/

# INE Callejero downloaded by hand (no API) + AUF_mun.xlsx (INE Functional Urban
# Areas, downloaded from ine.es) used to derive warehouse_province_map and
# warehouse_service_area — large reference files, not source code. The truth
# is the versioned CSV seeds in platform/dbt/seeds/; see
# scripts/derive_warehouse_province_map.py and scripts/derive_warehouse_service_area.py.
temp/

# Venvs: the platform's and Airflow's. The Source one (venv/) is already above.
platform/.venv/
orchestration/.venv/

# dbt artifacts. The real data lives in object storage; the .duckdb is only local state.
platform/dbt/target/
platform/dbt/logs/
# dbt writes logs/ RELATIVE to the cwd, not to --project-dir: running dbt from inside
# platform/ creates platform/logs/. One of them was once committed by mistake.
platform/logs/
platform/dbt/retail.duckdb
platform/dbt/package-lock.yml

# Local MinIO / platform credentials.
.env

# Snowflake connection. The truth is ~/.snowflake/config.toml, outside the repo; this file
# only exists as a local draft and must never be committed.
.env.snowflake

platform/dbt/.user.yml

# Personal review notebook
FAQ.md


# MAPA benchmark document: 29 MB of binary, and git history is permanent.
# The traceability the repo needs is in docs/README.md (URL + sha256 + date) and in the
# `informe_section` column of mapa_2025_benchmark_seed.csv, which cites each number's section.
docs/*.pdf

# Screencasts: same reason as the MAPA PDF, only worse — tens of MB per file, and
# git history is permanent. Screenshots (light, PNG) may be versioned as evidence;
# video may not. Referencing the local file in prose does not require committing it.
docs/screens/*.webm
docs/screens/*.mp4
docs/screens/*.mov
