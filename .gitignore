__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Temporarios da escrita atomica: nunca devem sobreviver a uma execucao.
.tmp-*.json

# Configuracao local de maquina.
.claude/settings.local.json

# Os snapshots em data/ sao artefato de execucao, nao codigo-fonte. A verdade do RAW
# passou a ser o object storage (s3://retail-raw/...); data/ e scratch da extracao.
data/

# Callejero do INE baixado manualmente (sem API) + AUF_mun.xlsx (Areas Urbanas
# Funcionais do INE, baixado de ine.es) usados para derivar warehouse_province_map e
# warehouse_service_area — arquivos grandes de referencia, nao codigo-fonte. A verdade
# passa a ser os seeds CSV em platform/dbt/seeds/, versionados; ver
# scripts/derive_warehouse_province_map.py e scripts/derive_warehouse_service_area.py.
temp/

# Venvs: da plataforma e do Airflow. O da Source (venv/) ja esta acima.
platform/.venv/
orchestration/.venv/

# Artefatos do dbt. O dado real vive no object storage; o .duckdb e so estado local.
platform/dbt/target/
platform/dbt/logs/
# O dbt escreve logs/ RELATIVO ao cwd, nao ao --project-dir: rodar dbt de dentro de
# platform/ cria platform/logs/. Um deles ja foi commitado por engano.
platform/logs/
platform/dbt/retail.duckdb
platform/dbt/package-lock.yml

# Credenciais locais do MinIO / plataforma.
.env

# Conexao do Snowflake. A verdade e ~/.snowflake/config.toml, fora do repo; este arquivo
# so existe como rascunho local e nunca deve ser commitado.
.env.snowflake

platform/dbt/.user.yml

# Caderno de conferencia pessoal ("livro do professor"): perguntas e respostas sobre o
# projeto, para consulta de quem o construiu. Nao e documentacao do repositorio — o que
# um terceiro precisa saber esta em README.md e ARCHITECTURE.md.
FAQ.md

# Documento de benchmark do MAPA: 29 MB de binario, e o historico do git e permanente.
# A rastreabilidade que o repo precisa esta em docs/README.md (URL + sha256 + data) e na
# coluna `informe_section` de mapa_2025_benchmark_seed.csv, que cita a secao de cada numero.
docs/*.pdf

# Screencasts: mesma razao do PDF do MAPA, so que pior — dezenas de MB por arquivo, e o
# historico do git e permanente. Print (leve, PNG) pode ser versionado como evidencia;
# video, nao. Referenciar o arquivo local em prosa nao exige commita-lo.
docs/screens/*.webm
docs/screens/*.mp4
docs/screens/*.mov
