# Dockerfile.airflow does NOT copy code — the repository is mounted at runtime. This
# file exists so the build context does not carry what is not needed: without it, the
# snapshots and venvs are sent to the daemon on every build.
.git
data
venv
platform/.venv
orchestration/.venv
platform/dbt/target
platform/dbt/logs
platform/dbt/retail.duckdb
**/__pycache__
**/*.egg-info
**/*.pyc
.env
