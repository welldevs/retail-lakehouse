# Airflow image with what the DAG needs to invoke.
#
# TWO RUNTIMES, ON PURPOSE. Airflow and dbt-core pin conflicting versions of
# jinja2, click and pydantic; installing both into the same interpreter is a fight that
# does not need to be picked. So:
#
#   /usr/local/bin/python   Airflow  +  the SOURCE (via PYTHONPATH)
#   /opt/platform-venv      boto3, duckdb, dbt-duckdb
#
# The Source fits into the Airflow interpreter with no risk at all because it has
# dependencies = [] — there is no third-party package to conflict. That is the practical
# payoff of that decision, here: zero dependencies means it runs anywhere.
#
# No CODE is copied into the image. The repository is mounted at runtime and reached
# through PYTHONPATH, so that editing a dbt model or a platform module does not require a
# rebuild. Only the DEPENDENCIES live in the image.

FROM apache/airflow:2.10.5-python3.12

USER root

# THE DEPENDENCY LIST LIVES IN ONE PLACE ONLY: platform/pyproject.toml.
#
# It used to be duplicated here, and the duplication did what duplication does. Phase 2
# added `dbt-snowflake` and `snowflake-connector-python` to the pyproject; this image
# kept the Phase 1 list; the `warehouse_load` DAG failed in `load_stage` with
# "snowflake-connector-python is not installed in this venv" — and it failed at RUNTIME, days
# later, instead of at build time. Reading the pyproject removes the whole class of problem.
#
# Copying the pyproject does not violate "no code goes into the image": it is dependency
# METADATA, and the code still arrives through the mount.
COPY platform/pyproject.toml /tmp/platform-pyproject.toml

# The platform venv lives in /opt, outside the airflow user's HOME, and is readable by
# everyone: the scheduler and the worker run as `airflow` and only execute it.
#
# THE FINAL CHECK IS PART OF THE BUILD and imports the dbt adapters plus the
# connector. If a dependency disappears from the image, the build breaks here — not the DAG,
# days later, with the data stuck halfway.
RUN python -m venv /opt/platform-venv \
 && /opt/platform-venv/bin/python -c "\
import tomllib, subprocess; \
deps = tomllib.load(open('/tmp/platform-pyproject.toml', 'rb'))['project']['dependencies']; \
print('installing:', ', '.join(deps)); \
subprocess.check_call(['/opt/platform-venv/bin/pip', 'install', '--no-cache-dir', '--quiet', *deps])" \
 && chmod -R a+rX /opt/platform-venv \
 && /opt/platform-venv/bin/python -c "\
import boto3, confluent_kafka, duckdb, psycopg, pyiceberg, snowflake.connector; \
from dbt.adapters.duckdb import DuckDBAdapter; \
from dbt.adapters.snowflake import SnowflakeAdapter; \
from dbt.adapters.postgres import PostgresAdapter; \
print('platform venv OK: boto3, duckdb, psycopg, confluent-kafka, pyiceberg, dbt-duckdb, dbt-snowflake, dbt-postgres, snowflake-connector')"

USER airflow

# Postgres provider for the LocalExecutor metadata DB.
RUN pip install --no-cache-dir --quiet "apache-airflow-providers-postgres==5.14.0"
