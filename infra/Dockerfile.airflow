# Imagem do Airflow com o que o DAG precisa invocar.
#
# DUAS RUNTIMES, DE PROPOSITO. O Airflow e o dbt-core fixam versoes conflitantes de
# jinja2, click e pydantic; instalar os dois no mesmo interpretador e uma briga que nao
# precisa ser comprada. Entao:
#
#   /usr/local/bin/python   Airflow  +  a SOURCE (via PYTHONPATH)
#   /opt/platform-venv      boto3, duckdb, dbt-duckdb
#
# A Source cabe no interpretador do Airflow sem nenhum risco porque ela tem
# dependencies = [] — nao existe pacote de terceiros para conflitar. E o retorno pratico
# daquela decisao, aqui: zero dependencia significa que ela roda em qualquer lugar.
#
# Nenhum CODIGO e copiado para a imagem. O repositorio e montado em runtime e alcancado
# por PYTHONPATH, para que editar um modelo dbt ou um modulo da plataforma nao exija
# rebuild. So as DEPENDENCIAS ficam na imagem.

FROM apache/airflow:2.10.5-python3.12

USER root

# A LISTA DE DEPENDENCIAS VIVE NUM LUGAR SO: platform/pyproject.toml.
#
# Antes ela estava duplicada aqui, e a duplicacao fez o que duplicacao faz. A Fase 2
# acrescentou `dbt-snowflake` e `snowflake-connector-python` ao pyproject; esta imagem
# continuou com a lista da Fase 1; a DAG `warehouse_load` falhou em `load_stage` com
# "snowflake-connector-python nao esta instalado neste venv" — e falhou em RUNTIME, dias
# depois, em vez de no build. Ler o pyproject elimina a classe inteira do problema.
#
# Copiar o pyproject nao viola "nenhum codigo vai para a imagem": e METADADO de
# dependencia, e o codigo continua chegando por mount.
COPY platform/pyproject.toml /tmp/platform-pyproject.toml

# O venv da plataforma vive em /opt, fora do HOME do usuario airflow, e fica legivel para
# todos: o scheduler e o worker rodam como `airflow` e apenas o executam.
#
# A CONFERENCIA FINAL E PARTE DO BUILD e importa os DOIS adaptadores do dbt mais o
# conector. Se uma dependencia sumir da imagem, o build quebra aqui — nao a DAG, dias
# depois, com o dado parado no meio do caminho.
RUN python -m venv /opt/platform-venv \
 && /opt/platform-venv/bin/python -c "\
import tomllib, subprocess; \
deps = tomllib.load(open('/tmp/platform-pyproject.toml', 'rb'))['project']['dependencies']; \
print('instalando:', ', '.join(deps)); \
subprocess.check_call(['/opt/platform-venv/bin/pip', 'install', '--no-cache-dir', '--quiet', *deps])" \
 && chmod -R a+rX /opt/platform-venv \
 && /opt/platform-venv/bin/python -c "\
import boto3, confluent_kafka, duckdb, psycopg, pyiceberg, snowflake.connector; \
from dbt.adapters.duckdb import DuckDBAdapter; \
from dbt.adapters.snowflake import SnowflakeAdapter; \
print('platform venv OK: boto3, duckdb, psycopg, confluent-kafka, pyiceberg, dbt-duckdb, dbt-snowflake, snowflake-connector')"

USER airflow

# Provider do Postgres para o metadata DB do LocalExecutor.
RUN pip install --no-cache-dir --quiet "apache-airflow-providers-postgres==5.14.0"
