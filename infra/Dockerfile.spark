# Spark image with what the stock job and the experiment need to reach.
#
# WHY AN IMAGE, AND NOT `pip install pyspark` IN THE PLATFORM VENV.
#
# The platform venv is the dependency of the DEFAULT PATH: `make silver`, `make warehouse`,
# the DAGs. Installing pyspark there puts Spark — and the JVM — in the dependency tree of
# people who will never use it. Spark is optional in this project by decision, so it lives
# where the optional lives: a service under a profile, like the stream plane.
#
# THE THREE JARS ARE THE EXPERIMENT. Downloading them at BUILD time, with pinned versions, is
# what makes the spike result a repeatable measurement instead of "it worked that day":
#
#   iceberg-spark-runtime   the Iceberg catalog, reader and writer inside Spark
#   iceberg-aws-bundle      S3FileIO — reads the SAME `s3://` as pyiceberg's PyArrowFileIO
#   postgresql              the JDBC driver for the catalog, which is a plain Postgres
#
# `--packages` at runtime was REJECTED: it resolves through Ivy on every run, needs network
# at run time and does not pin what was measured.
#
# No CODE goes into the image — same rule as Dockerfile.airflow. The repository is
# mounted at runtime and reached through PYTHONPATH.

FROM apache/spark:3.5.3

USER root

ARG ICEBERG_VERSION=1.7.1
ARG POSTGRES_JDBC_VERSION=42.7.4
ARG MAVEN=https://repo1.maven.org/maven2

RUN set -eux; \
    cd /opt/spark/jars; \
    curl -fsSLO "${MAVEN}/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/${ICEBERG_VERSION}/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar"; \
    curl -fsSLO "${MAVEN}/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar"; \
    curl -fsSLO "${MAVEN}/org/postgresql/postgresql/${POSTGRES_JDBC_VERSION}/postgresql-${POSTGRES_JDBC_VERSION}.jar"

# pandas + pyarrow: `applyInPandas` is the shape that justifies Spark in this project (a
# running sum fed back by its own state). Without pyarrow Spark falls back to a slow path and
# warns at WARN — which would turn the job's measurement into a number about the wrong environment.
#
# THE VERSIONS ARE THE ONES THE IMAGE'S PYTHON ACCEPTS, not the platform venv's. The
# `apache/spark:3.5.3` image ships Python 3.8.10; pandas stopped at 2.0.3 for that series.
# Finding that out at build time is the point of installing here instead of at runtime — the
# alternative is the job failing on the executor, in the middle of a measurement. The platform
# venv does NOT need to follow: the two interpreters are independent on purpose, as in
# Dockerfile.airflow.
RUN pip install --no-cache-dir --quiet "pandas==2.0.3" "pyarrow==17.0.0"

# The final check is part of the build: if a jar is not on the classpath, the build breaks
# here and not the spike, with a ClassNotFoundException in the middle of a measurement.
RUN set -eux; \
    ls /opt/spark/jars/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar; \
    ls /opt/spark/jars/iceberg-aws-bundle-${ICEBERG_VERSION}.jar; \
    ls /opt/spark/jars/postgresql-${POSTGRES_JDBC_VERSION}.jar; \
    python3 -c "import pandas, pyarrow; print('pandas', pandas.__version__, 'pyarrow', pyarrow.__version__)"

# PYTHONPATH LIVES IN THE IMAGE, not in compose. Concrete, measured reason: the
# `apache/spark:3.5.3` image leaves PYTHONPATH EMPTY — `spark-submit` builds it at
# runtime. A `PYTHONPATH` set in compose therefore does not add to the image's: it is the
# only one there is, and wiping pyspark's own path is the result. That is
# exactly what happened on the spike's first run, and the symptom
# (`ModuleNotFoundError: No module named 'pyspark'` inside the Spark image) does not point
# to the cause.
#
# `/repo/platform/src` is the mount the compose `spark` service guarantees. The image is made
# for this repository — just like Airflow's, which knows `/opt/retail-lakehouse`.
ENV PYTHONPATH=/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip:/repo:/repo/platform/src

USER spark
